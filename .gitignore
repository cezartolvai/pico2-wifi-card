# Repo-ul este git-managed (ramură main). Credențialele nu se comită.

build/
# Directoare de build secundare, folosite pentru verificări (build-usbonly,
# build-trace, ...). Nu sunt cod sursă și se regenerează din CMake.
build-*/
CMakeCache.txt
CMakeFiles/
*.uf2
*.uf2.map
*.elf
*.elf.map
*.bin

# SDK-ul vendorat (100+ MB) nu se comită
.pico-sdk/

# Scripturile de validare generează cache Python
__pycache__/
*.pyc

# Fișiere locale de credențiale - nu se comită niciodată
credentials.cmake
bridge-credentials.cmake
*.local.cmake
.env

# Regulile locale ale agentului (documentația de lucru Cline). Rămân pe disc, nu se publică.
.clinerules/
